  query servicesForOwnerSearch($ownerId: String!) {
    servicesForOwner(ownerId: $ownerId) {
      id
      __typename
      name
      lastDeployedAt
      updatedAt
      userFacingTypeSlug
      suspenders
      env {
        id
      }
      environment {
        id
        name
        project {
          name
        }
      }
