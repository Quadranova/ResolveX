  mutation updateServerCacheProfile(
    $id: String!
    $cacheProfile: ServerCacheProfile!
  ) {
    updateServerCacheProfile(id: $id, cacheProfile: $cacheProfile) {
      id
      cacheProfile
    }
  }
`),xB=new aa(Er`
  query serverCacheProfileQuery($id: String!) {
    server(id: $id) {
      id
      cacheProfile
    }
  }
`),SB=new Ta(Er`
  mutation purgeServerCache($id: String!) {
    purgeServerCache(id: $id) {
      id
    }
  }
`),CB=new aa(Er`
  query serverCacheEvents($id: String!) {
    serviceEvents(
      serviceId: $id
      include: ["DeployStarted", "EdgeCachePurged", "EdgeCacheEnabled"]
      limit: 1
    ) {
      events {
        id
        timestamp
        ... on EdgeCachePurged {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on EdgeCacheEnabled {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
        ... on DeployStarted {
          trigger {
            system
            manual
            user {
              id
              email
              avatarDownload {
                url
              }
            }
          }
        }
      }
