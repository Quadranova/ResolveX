  fragment customDomainFields on CustomDomain {
    id
    name
    verified
    publicSuffix
    redirectForName
    isApex
    server {
      id
      name
      userFacingTypeSlug
      environment {
        id
        name
        project {
          id
          name
        }
      }
    }
  }
`,vz=new aa(Er`
  query customDomains($serverId: String!) {
    customDomains(serverId: $serverId) {
      ...customDomainFields
    }
  }
  ${_z}
`),yz=new aa(Er`
  query customDomainsForOwner($ownerId: String!, $includeRedirects: Boolean!) {
    customDomainsForOwner(
      ownerId: $ownerId
      includeRedirects: $includeRedirects
    ) {
      ...customDomainFields
    }
  }
  ${_z}
`),bz=Er`
  mutation createCustomDomainsMutation($customDomain: CustomDomainInput!) {
    createCustomDomains(customDomain: $customDomain) {
      ...customDomainFields
    }
  }
  ${_z}
`,xz=Er`
  mutation deleteCustomDomainMutation($id: String!) {
    deleteCustomDomain(id: $id)
  }
`,Sz=Er`
  mutation refreshCustomDomainStatusMutation($id: String!) {
    refreshCustomDomainStatus(id: $id)
  }
`,Cz=new aa(Er`
    query certificate($domain: String!, $serverId: String!) {
      certificate(domain: $domain, serverId: $serverId) {
        id
        domain
        issued
        errors
