  mutation UpdateServerAuthConfig($id: String!, $authConfig: AuthConfigInput!) {
    updateServerAuthConfig(id: $id, authConfig: $authConfig) {
      id
      authConfig {
        enabled
        clientId
        clientSecretSet
        skipAuthRoutes {
          method
          pathPattern
        }
      }
      deploy {
        id
      }
      maintenanceMode {
        enabled
        uri
      }
    }
  }
